# Single public entry point. TLS is automatic: a locally-trusted certificate for
# "localhost", Let's Encrypt for a real domain (set ALGOTRADER_DOMAIN).
{$ALGOTRADER_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API and the dashboard WebSocket (/api/ws) go to FastAPI.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Interactive API docs are never exposed publicly.
	handle /api/docs* {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
