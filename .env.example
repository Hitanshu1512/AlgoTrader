# Copy to .env and fill in. .env is gitignored. Never commit real values.
# Production secrets move to AWS SSM Parameter Store + KMS in Phase 7.

# Database password used by the postgres container and the backend.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Public hostname. "localhost" gets a locally-trusted TLS certificate from Caddy;
# a real domain gets a Let's Encrypt certificate automatically.
ALGOTRADER_DOMAIN=localhost

# development | staging | production  (staging/production enforce https + master key)
ALGOTRADER_APP_ENV=development
ALGOTRADER_LOG_LEVEL=INFO

# ── Backend settings for running outside Docker (uvicorn on your machine) ──
# ALGOTRADER_DATABASE_URL=postgresql+asyncpg://algotrader:algotrader@localhost:5432/algotrader
# ALGOTRADER_REDIS_URL=redis://localhost:6379/0
# ALGOTRADER_PUBLIC_ORIGIN=http://localhost:3000
# ALGOTRADER_COOKIE_SECURE=false
# ALGOTRADER_MASTER_KEY_FILE=../secrets/master_key
